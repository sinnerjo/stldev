    "deleteRule": null,
    "fields": [
      { "name": "id", "type": "text", "system": true, "primaryKey": true, "required": true, "min": 15, "max": 15, "pattern": "^[a-z0-9]+$", "autogeneratePattern": "[a-z0-9]{15}" },
      { "name": "code", "type": "text", "required": true, "min": 6, "max": 6, "pattern": "^[A-Z0-9]{6}$" },
      { "name": "meta", "type": "json", "required": false, "maxSize": 20000 },
      { "name": "meta_rev", "type": "number", "required": false, "onlyInt": true, "min": 0 },
      { "name": "created", "type": "autodate", "onCreate": true, "onUpdate": false },
      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": [
      "CREATE UNIQUE INDEX `idx_matchtap_games_code` ON `matchtap_games` (`code`)"
    ]
  },
  {
    "name": "matchtap_events",
    "type": "base",
    "listRule": "game = @request.query.code",
