      { "name": "updated", "type": "autodate", "onCreate": true, "onUpdate": true }
    ],
    "indexes": [
      "CREATE UNIQUE INDEX `idx_matchtap_claims_game_device` ON `matchtap_claims` (`game`, `device_id`)"
    ]
  }
]
